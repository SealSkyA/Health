# ── 基础 ──
HOST=127.0.0.1
PORT=35000
TIMEZONE=Asia/Shanghai

# ── 安全（部署时必须改为强随机值！）──
JWT_SECRET=change-this-to-a-random-string
ADMIN_PASSWORD=change-me

# ── 数据库（127.0.0.1:3306，仅本机）──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=100Trust!@
DB_NAME=3healthtrends

# ── MinIO（对象存储）──
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=3healthtrends

# ── OnlyOffice ──
OFFICE_PUBLIC_BASE=http://172.17.0.1:8000
OFFICE_SERVER_URL=http://172.17.0.1:8081
OFFICE_SECRET=

# ── 上传 ──
MAX_UPLOAD_SIZE=10485760

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:35000